DATABASE_URL=sqlite:///./bejaa_pet.db
APP_NAME=Bejaa Pet Management
DEBUG=true

# CORS — comma-separated list of allowed frontend origins
# Production example: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# WhatsApp automation (UltraMsg — https://app.ultramsg.com)
# Leave blank to run in DRY RUN mode
WA_INSTANCE=
WA_TOKEN=

# Shared secret between the Next.js server and this API (long random string, same value on Vercel)
API_KEY=

# First boss login, created once while the staff list is empty (add more people on the Staff page)
ADMIN_USERNAME=
ADMIN_PASSWORD=
